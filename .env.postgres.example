# Credenciales exclusivamente locales para PostgreSQL de validación.
# Copiar como .env.postgres y reemplazar los placeholders; no reutilizar en producción.
POSTGRES_ADMIN_PASSWORD=replace-local-admin-password
GIOT_DB_NAME=giot
GIOT_DB_USER=giot_app
GIOT_DB_PASSWORD=replace-local-app-password
POSTGRES_PORT=54329

# Usar esta URL al ejecutar Alembic/API/tests contra el contenedor local.
DATABASE_URL=postgresql+psycopg://giot_app:replace-local-app-password@localhost:54329/giot
